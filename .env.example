# Public-post ingestion (app-only bearer token).
X_BEARER_TOKEN=

# Watch only these four accounts. Includes original posts and replies, not reposts.
X_STREAM_RULE=(from:ShamsCharania OR from:ChrisBHaynes OR from:memgrizz OR from:GrizzliesPR) -is:retweet
X_STREAM_RULE_TAG=shams-x-chat
X_SOURCE_USERNAME=ShamsCharania

# Start safely: print links without sending encrypted chat messages.
CHAT_DRY_RUN=true

# Set these for live X Chat delivery.
X_ACCESS_TOKEN=
CHAT_CONVERSATION_ID=
CHAT_BOT_USER_ID=
CHAT_PRIVATE_KEYS_B64=
CHAT_SIGNING_KEY_VERSION=1

# Runtime state and startup behavior.
STATE_DB=state/bot.sqlite3
LOG_LEVEL=INFO
