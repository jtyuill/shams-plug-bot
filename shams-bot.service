[Unit]
Description=Four-account X Chat post bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jacob/shams-bot
ExecStart=/home/jacob/shams-bot/.venv/bin/python -m shamsbot.cli
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
